# The free setup (docs/START_HERE.md): openGym on GitHub Pages, with sign-in and sync through
# Supabase instead of the openGym server. `npm run build -- --mode supabase` (and the Pages
# workflow) read this file; every other build ignores it.
#
# Both values are public by design — the publishable key is in every copy of the app anyway, and it
# only reaches the og_* functions, which check each caller's own session (supabase/migrations).
VITE_SUPABASE_URL=https://qbzqrzkauwqnffsslrqr.supabase.co
VITE_SUPABASE_KEY=sb_publishable_MqMV4oTCy3QpEowQgf4Dtg_9PvhJYZR
